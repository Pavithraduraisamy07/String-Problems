      String s="hachathatha";
        int count=0;
        for(int i=0;i<s.length()-1;i++){
            
            if(s.charAt(i)=='h'&& s.charAt(i+1)=='a'){
            count++;
        }
        
    }
    System.out.println(count);
}
}
