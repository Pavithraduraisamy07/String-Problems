import java.util.Arrays;
import java.lang.*;
public class reverse {
    public static void main(String[] args) {
         String []str={"p","a","v","i"};
        int left=0;
        int right=str.length-1;
        while(left<right){
            String temp=str[left];
            str[left]=str[right];
            str[right]=temp;
            left++;
            right--;
        }
        for(String s:str){
            System.out.println(s);
        }
}
}
