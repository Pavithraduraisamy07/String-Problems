import java.util.Arrays;
import java.lang.*;
public class vowels {
    public static void main(String[] args) {
String str="pavi";
            int count=0;
            
            for(int i=0;i<str.length();i++){
                char ch=str.charAt(i);
                if(ch =='a' ||ch =='e' ||ch =='i' ||ch =='o' ||ch =='u' ){
                    count++;
                }
                
            }
            System.out.println(count);
}
}
